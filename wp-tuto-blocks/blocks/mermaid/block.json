{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-tuto-blocks/mermaid",
	"version": "1.1.0",
	"title": "Diagramme Mermaid",
	"category": "media",
	"icon": "networking",
	"description": "Collez du code Mermaid — taille configurable, zoom en modale au clic. JS/CSS chargés uniquement si le bloc est présent.",
	"keywords": [
		"mermaid",
		"diagramme",
		"flowchart",
		"graph",
		"uml",
		"sequence"
	],
	"textdomain": "wp-tuto-blocks",
	"attributes": {
		"code": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": "center"
		},
		"maxWidth": {
			"type": "string",
			"default": "100%"
		},
		"enableModal": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"spacing": {
			"margin": true
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css"
}